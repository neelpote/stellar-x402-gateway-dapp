# Stellar account that receives x402 payments.
PAYMENT_RECIPIENT_ADDRESS=G...

# Secret key used only by scripts/agent.ts. Never expose this to the browser.
AGENT_PRIVATE_KEY=S...

# OpenZeppelin x402 testnet facilitator credential.
