# Issuer used by the account setup and balance helper scripts.
USDC_ISSUER_ADDRESS=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Optional after deploying the independent Soroban contract-payment path.
DATA_REGISTRY_CONTRACT_ID=C...
ACCESS_CONTROLLER_CONTRACT_ID=C...
